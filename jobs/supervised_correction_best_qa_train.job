#!/usr/bin/env bash
#SBATCH --job-name=supcorr_besttrain
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=10
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=%x_%j_log
set -euo pipefail
cd /home/shaohan/contour_qa_experiments
ROI="${ROI:?ROI must be exported}"
FOLD="${FOLD:?FOLD must be exported}"
VARIANT="${VARIANT:-large_decoder_ft_last2}"
ACTION_WEIGHT="${ACTION_WEIGHT:-4.0}"
ENCODER_LR="${ENCODER_LR:-1e-6}"
export ACTION_WEIGHT ENCODER_LR
bash scripts/dino_shape/run_supervised_correction_best_qa_train.sh \
  "${ROI}" "${FOLD}" "${VARIANT}"
