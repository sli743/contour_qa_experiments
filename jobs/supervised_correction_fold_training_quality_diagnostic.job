#!/usr/bin/env bash
#SBATCH --job-name=supcorr_foldqual
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=%x_%j_log
set -euo pipefail

cd /home/shaohan/contour_qa_experiments
ROI="${ROI:-Lung_L}"
VARIANT="${VARIANT:-large_decoder_ft_last2}"
FOLDS_EXPORT="${FOLDS_EXPORT:-0:1:2:3:4}"
FOLDS="${FOLDS_EXPORT//:/,}"
QA_METHOD="${QA_METHOD:-joint_spatial_action_head}"
BAD_PERCENTILE="${BAD_PERCENTILE:-75}"
STUDY_ROOT="${STUDY_ROOT:-/scratch/shaohan/contour_QA/supervised_autoseg_correction}"

FOLDS="${FOLDS}" QA_METHOD="${QA_METHOD}" BAD_PERCENTILE="${BAD_PERCENTILE}" STUDY_ROOT="${STUDY_ROOT}" \
  bash scripts/dino_shape/run_supervised_correction_fold_training_quality_diagnostic.sh \
  "${ROI}" "${VARIANT}"
