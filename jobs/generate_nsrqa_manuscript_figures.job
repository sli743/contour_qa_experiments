#!/usr/bin/env bash
#SBATCH --job-name=nsrqa_figures
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
