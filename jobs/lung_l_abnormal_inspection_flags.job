#!/bin/bash
#SBATCH -J lungL_abnflag
#SBATCH -p hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=04:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
CONFIG="${CONFIG:-${PROJECT_ROOT}/configs/dino_shape/lung_l_abnormal_inspection_flags.yaml}"

cd "${PROJECT_ROOT}"

# Patient-level multiprocessing already uses all allocated CPUs. Avoid nested
# BLAS/OpenMP/ITK thread pools inside every worker.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1

python -m analysis.flag_lung_l_abnormal_inspection_cases --config "${CONFIG}"
