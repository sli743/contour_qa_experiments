#!/usr/bin/env bash
#SBATCH --job-name=lungL_ctc_post
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
set -euo pipefail
PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
ROI="${ROI:-Lung_L}"
ROI_LC="${ROI,,}"
STUDY_ROOT="${STUDY_ROOT:-/scratch/shaohan/contour_QA/${ROI_LC}_ct_contour_nsrqa_v1}"
V3_STUDY="${V3_STUDY:-/scratch/shaohan/contour_QA/${ROI_LC}_nsrqa_month_temporal_family_validated_v1}"
if [[ "${ROI}" == "Lung_L" ]]; then
  NOCORR_STUDY="${NOCORR_STUDY:-/scratch/shaohan/contour_QA/lung_l_nsrqa_corruption_ablation_month_temporal_v1}"
  WATCH="${WATCH-148,138,103,47,135}"   # Lung_L patients whose ranks are reported
else
  NOCORR_STUDY="${NOCORR_STUDY:-${V3_STUDY}}"
  WATCH="${WATCH-}"
fi
WATCH_ARGS=()
[[ -n "${WATCH}" ]] && WATCH_ARGS=(--watch "${WATCH}")
SEED="${SEED:-91}"
# DESIGN=full: the 2x2 corruption x CT ablation + ct_only (Lung_L/Lung_R).
# DESIGN=core: the generic pipeline, C1I1 (+ CT-absent) vs C0I0, plus ct_only if trained.
DESIGN="${DESIGN:-full}"
DEPTHS="${DEPTHS:-3,4.5,5.25,6,7.5}"
MIN_COMPONENT_ML="${MIN_COMPONENT_ML:-0.05}"
cd "${PROJECT_ROOT}"
source "${PROJECT_ROOT}/scripts/dino_shape/activate_3dino_env.sh"
export PYTHONPATH="${PROJECT_ROOT}:${PYTHONPATH:-}"

# Contour-only reference arms: link their Month3 evaluations per seed.
# Seed 91's no-corruption arm lives in NOCORR_STUDY; extra seeds train it in
# V3_STUDY (submit_lung_l_ct_contour_ablation_seeds.sh sets NOCORR_STUDY=V3_STUDY).
EV="${STUDY_ROOT}/evaluations"
mkdir -p "${EV}"
link_seed() {  # link_seed <arm name in EV> <source arm dir>
  local dst="${EV}/$1" src="$2" old s
  if [[ -L "${dst}" ]]; then  # older layout: whole-arm symlink -> per-seed links
    old="$(readlink -f "${dst}")"; rm "${dst}"; mkdir -p "${dst}"
    for s in "${old}"/seed*; do [[ -e "${s}" ]] && ln -sfn "${s}" "${dst}/$(basename "${s}")"; done
  fi
  mkdir -p "${dst}"
  ln -sfn "${src}/seed${SEED}" "${dst}/seed${SEED}"
}
link_seed contour_only_no_corruption "${NOCORR_STUDY}/evaluations/no_corruption"
if [[ "${DESIGN}" == "full" ]]; then
  link_seed contour_only_v3 "${V3_STUDY}/evaluations/nsrqa_corruption"
  ARMS=(ct_contour_corruption ct_contour_no_corruption ct_only_segmenter
        ct_contour_corruption_ct_absent ct_contour_no_corruption_ct_absent
        contour_only_v3 contour_only_no_corruption)
else
  ARMS=(ct_contour_corruption ct_contour_corruption_ct_absent contour_only_no_corruption)
  [[ -d "${EV}/ct_only_segmenter/seed${SEED}/actual_autoseg_cases" ]] && ARMS+=(ct_only_segmenter)
fi
for arm in "${ARMS[@]}"; do
  [[ -d "${EV}/${arm}/seed${SEED}/actual_autoseg_cases" ]] || { echo "Missing evaluation: ${EV}/${arm}" >&2; exit 1; }
done

python -m analysis.score_nsrqa_floor_corrected \
  --eval-root "${EV}" \
  --arms "${ARMS[@]}" \
  --reference-arm contour_only_no_corruption \
  --seed "${SEED}" \
  --roi "${ROI}" ${WATCH_ARGS[@]+"${WATCH_ARGS[@]}"} \
  --depth-thresholds "${DEPTHS}" --min-component-ml "${MIN_COMPONENT_ML}" \
  --output-dir "${STUDY_ROOT}/evaluations_floor_corrected/seed${SEED}"

# Per-arm depth-threshold calibration (label-free clean-floor rule + supervised check).
python -m analysis.calibrate_nsrqa_depth_threshold \
  --eval-root "${EV}" \
  --arms "${ARMS[@]}" \
  --seed "${SEED}" \
  --roi "${ROI}" ${WATCH_ARGS[@]+"${WATCH_ARGS[@]}"} --min-component-ml "${MIN_COMPONENT_ML}" \
  --output-dir "${STUDY_ROOT}/evaluations_floor_corrected/seed${SEED}_depth_sweep"

# 2x2 corruption x CT ablation for this seed (aggregate seeds with
# analysis.ablation_corruption_ct_seeds once all seeds are done). The core design
# has no 2x2; its comparison is region detection (jobs/nsrqa_region_detection.job).
[[ "${DESIGN}" == "full" ]] && python -m analysis.ablation_corruption_ct  --cell C0I0="${EV}/contour_only_no_corruption"   --cell C1I0="${EV}/contour_only_v3"   --cell C0I1="${EV}/ct_contour_no_corruption"   --cell C1I1="${EV}/ct_contour_corruption"   --extra C1I1_ct_absent="${EV}/ct_contour_corruption_ct_absent@C1I1"   --extra C0I1_ct_absent="${EV}/ct_contour_no_corruption_ct_absent@C0I1"   --extra ct_only="${EV}/ct_only_segmenter"   --combine rankavg_C1I1_ctonly=C1I1+ct_only   --seed "${SEED}" --roi "${ROI}" ${WATCH_ARGS[@]+"${WATCH_ARGS[@]}"}   --output-dir "${STUDY_ROOT}/evaluations_floor_corrected/seed${SEED}_ablation"
[[ "${DESIGN}" == "full" ]] && python -m analysis.plot_ablation_corruption_ct   --ablation-dir "${STUDY_ROOT}/evaluations_floor_corrected/seed${SEED}_ablation"

# Gate / CT-injection trajectory per CT arm, for quick inspection.
for f in "${STUDY_ROOT}"/models/*/*seed${SEED}/logs/image_guidance.csv; do
  echo "== ${f}"; tail -n 3 "${f}"
done
