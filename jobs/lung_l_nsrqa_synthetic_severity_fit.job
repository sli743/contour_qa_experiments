#!/bin/bash
#SBATCH -J lungL_sevfit
#SBATCH -p hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH -o slurm-lungL-sevfit-%j.out
#SBATCH -e slurm-lungL-sevfit-%j.err

set -euo pipefail

REPO="${REPO:-/home/shaohan/contour_qa_experiments}"
cd "$REPO"

if command -v conda >/dev/null 2>&1; then
  source "$(conda info --base)/etc/profile.d/conda.sh"
  conda activate "${CONDA_ENV:-3DINO}"
fi

# Candidate fitting is parallelized across processes; keep numerical libraries
# single-threaded inside each process to avoid CPU/RAM oversubscription.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1

python -m analysis.fit_lung_l_nsrqa_synthetic_severity \
  --config configs/dino_shape/lung_l_nsrqa_synthetic_severity_fit.yaml
