#!/usr/bin/env bash
#SBATCH --job-name=lungL_dev_prep
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=04:00:00
