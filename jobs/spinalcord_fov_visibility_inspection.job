#!/bin/bash
#SBATCH --job-name=spcord_fov_audit
#SBATCH -p hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=spcord_fov_audit_%j.out
#SBATCH --error=spcord_fov_audit_%j.err

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
STUDY_ROOT="${STUDY_ROOT:-/scratch/shaohan/contour_QA/all_roi_NSRQA_study}"
RAW_DATA_ROOT="${RAW_DATA_ROOT:-/home/shaohan/radformation-data/data}"
OUTPUT_DIR="${OUTPUT_DIR:-${STUDY_ROOT}/spinalcord_fov_visibility_audit}"
HIDDEN_MM_THRESHOLD="${HIDDEN_MM_THRESHOLD:-5}"
MAJOR_HIDDEN_MM_THRESHOLD="${MAJOR_HIDDEN_MM_THRESHOLD:-50}"

MANIFEST="${STUDY_ROOT}/manifests/active_rois.tsv"
[[ -s "${MANIFEST}" ]] || { echo "Missing ${MANIFEST}" >&2; exit 2; }

line="$(awk -F '\t' 'NR>1 && $3=="SpinalCord" {print; exit}' "${MANIFEST}")"
[[ -n "${line}" ]] || { echo "SpinalCord is not present in ${MANIFEST}" >&2; exit 2; }
line="${line%$'\r'}"
IFS=$'\t' read -r roi_index registry_index ROI data_group profile GLOBAL_THRESHOLD_PCT LOCAL_DEPTH_MM PILOT_CONFIG BENCH_CONFIG RANDOM_CONFIG NSRQA_CONFIG <<< "${line}"
[[ "${ROI}" == "SpinalCord" ]] || { echo "Unexpected ROI parsed from manifest: ${ROI}" >&2; exit 2; }
[[ -s "${NSRQA_CONFIG}" ]] || { echo "Missing SpinalCord NSR-QA config: ${NSRQA_CONFIG}" >&2; exit 2; }

cd "${PROJECT_ROOT}"
source "${PROJECT_ROOT}/scripts/dino_shape/activate_3dino_env.sh"
export PYTHONPATH="${PROJECT_ROOT}:${PYTHONPATH:-}"

python -m analysis.inspect_spinalcord_fov_visibility \
  --config "${NSRQA_CONFIG}" \
  --raw-data-root "${RAW_DATA_ROOT}" \
  --output-dir "${OUTPUT_DIR}" \
  --splits training1 validation1 testing1 \
  --hidden-mm-threshold "${HIDDEN_MM_THRESHOLD}" \
  --major-hidden-mm-threshold "${MAJOR_HIDDEN_MM_THRESHOLD}"

echo "SpinalCord FOV visibility audit complete"
echo "  Output: ${OUTPUT_DIR}"
