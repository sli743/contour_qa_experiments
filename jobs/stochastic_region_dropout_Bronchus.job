#!/bin/bash
#SBATCH --job-name=srd_bronchus.job
#SBATCH --output=stochastic_region_dropout_bronchus.out
#SBATCH --error=stochastic_region_dropout_bronchus.err
#SBATCH -t 24:00:00
#SBATCH --gres gpu:1
#SBATCH --cpus-per-task 8
#SBATCH --mem 80G
#SBATCH -N 1
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu

. ~/miniconda/bin/activate
conda activate 3DINO
cd /home/shaohan/contour_qa_experiments

# Fresh run for the new Bronchus experiment.
bash scripts/dino_shape/run_dino_shape_stochastic_region_dropout_Bronchus_v1.sh --fresh
