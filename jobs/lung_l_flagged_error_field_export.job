#!/usr/bin/env bash
#SBATCH -J lungL_flagexport
#SBATCH -p hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
CONFIG="${CONFIG:-${PROJECT_ROOT}/configs/dino_shape/lung_l_flagged_error_field_export.yaml}"
cd "${PROJECT_ROOT}"

# Python multiprocessing owns the parallelism. Avoid nested thread pools in
# SimpleITK/NumPy/BLAS inside each patient worker.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1

python -m analysis.export_lung_l_flagged_error_field_cases --config "${CONFIG}"
