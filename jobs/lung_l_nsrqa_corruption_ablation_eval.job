#!/usr/bin/env bash
#SBATCH --job-name=lungL_nsrqa_eval
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48G
#SBATCH --time=08:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=slurm-%x-%A_%a.out
#SBATCH --error=slurm-%x-%A_%a.err
set -euo pipefail
PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
cd "${PROJECT_ROOT}"
exec bash scripts/dino_shape/run_lung_l_nsrqa_corruption_ablation_eval_task.sh "${SLURM_ARRAY_TASK_ID}"
