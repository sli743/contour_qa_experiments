#!/usr/bin/env bash
#SBATCH --job-name=supcorr_capft
#SBATCH --partition=hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=10
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=%x_%j_log
set -euo pipefail
cd /home/shaohan/contour_qa_experiments
ROI="${ROI:-Lung_L}"
FOLD="${FOLD:-0}"
VARIANT="${VARIANT:-baseline}"
ACTION_WEIGHT="${ACTION_WEIGHT:-4.0}"
ENCODER_LR="${ENCODER_LR:-1e-6}"
QA_N_BOOT="${QA_N_BOOT:-2000}"
export ACTION_WEIGHT ENCODER_LR QA_N_BOOT
bash scripts/dino_shape/run_supervised_correction_capacity_finetune_ablation.sh \
  "${ROI}" "${FOLD}" "${VARIANT}"
