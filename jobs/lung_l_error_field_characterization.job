#!/usr/bin/env bash
#SBATCH -J lungL_errfield
#SBATCH -p hugo
#SBATCH --account=geoffrey_hugo
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=shaohan@wustl.edu
#SBATCH --output=slurm-%x-%j.out
#SBATCH --error=slurm-%x-%j.err

set -euo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/home/shaohan/contour_qa_experiments}"
CONFIG="${CONFIG:-${PROJECT_ROOT}/configs/dino_shape/lung_l_error_field_characterization.yaml}"
cd "${PROJECT_ROOT}"

# Patient-level Python multiprocessing is the intended parallelism.  Keep
# nested numerical-library thread pools at one thread to avoid oversubscription.
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

python -m analysis.characterize_lung_error_fields --config "${CONFIG}" "$@"
